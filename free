local function getBall() local sys = workspace:FindFirstChild("TPSSystem"); return (sys and sys:FindFirstChild("TPS")) or workspace:FindFirstChild("Ball") end
local function fireLeg(ball)
    if _root  then fti(ball,_root,0);  fti(ball,_root,1)  end
    if _hasRleg then fti(ball,_rleg,0); fti(ball,_rleg,1) end
    if _hasLleg then fti(ball,_lleg,0); fti(ball,_lleg,1) end
end

local BUF_MAX = 8; local POS_BUF = {}; for i=1,BUF_MAX do POS_BUF[i]={t=0,pos=V3zero,vel=V3zero} end
local POS_HEAD, POS_LEN = 0, 0
local function recordBall(ball)
    POS_HEAD=(POS_HEAD%BUF_MAX)+1; local s=POS_BUF[POS_HEAD]; s.t=clock(); s.pos=ball.Position; s.vel=ball.AssemblyLinearVelocity
    if POS_LEN<BUF_MAX then POS_LEN=POS_LEN+1 end
end
local function getFrame(offset) return POS_BUF[((POS_HEAD-offset-1)%BUF_MAX)+1] end
local function smartPredict(ball, ahead)
    if POS_LEN<2 then return ball.Position+ball.AssemblyLinearVelocity*ahead, ball.AssemblyLinearVelocity end
    local s2=getFrame(0); local s1=getFrame(1); local dt=math.max(s2.t-s1.t, 0.016)
    local vpx=(s2.pos.X-s1.pos.X)/dt; local vpy=(s2.pos.Y-s1.pos.Y)/dt; local vpz=(s2.pos.Z-s1.pos.Z)/dt
    local ddx=s2.vel.X-vpx; local ddy=s2.vel.Y-vpy; local ddz=s2.vel.Z-vpz
    local kb=clamp((ddx*ddx+ddy*ddy+ddz*ddz)/1225,0,1)
    local blx=vpx*(1-kb)+s2.vel.X*kb; local bly=vpy*(1-kb)+s2.vel.Y*kb; local blz=vpz*(1-kb)+s2.vel.Z*kb
    local ax,ay,az=0,0,0
    if POS_LEN>=3 then
        local s0=getFrame(2); local dt0=s1.t-s0.t
        if dt0>0 then
            local v0x=(s1.pos.X-s0.pos.X)/dt0; local v0y=(s1.pos.Y-s0.pos.Y)/dt0; local v0z=(s1.pos.Z-s0.pos.Z)/dt0
            ax=clamp((vpx-v0x)/dt,-120,120); ay=clamp((vpy-v0y)/dt,-120,120); az=clamp((vpz-v0z)/dt,-120,120)
        end
    end
    local t=clamp(ahead,0.016,0.25); local half=0.5*t*t
    return V3(s2.pos.X+blx*t+ax*half, s2.pos.Y+bly*t+ay*half-9.8*ahead*ahead*(1-kb), s2.pos.Z+blz*t+az*half), V3(blx,bly,blz)
end

local _cachedPing, _lastPingT, HIGH_PING_MS, GRAV_HALF_SQ, INSIDE_THRESH = 0.05, 0, 0.10, -9.8*0.5*(1/60)*(1/60), 2.5
local function startReach2()
    if reachConn then reachConn:Disconnect() end
    reachPart.Size = reachSize
    reachConn = RunService.PreSimulation:Connect(function()
        if not _root or not _hum then return end
        local ball = getBall(); if not ball then return end
        local now = clock()
        if now-_lastPingT>=2 then _lastPingT=now; _cachedPing=clamp(lp:GetNetworkPing(),0.016,0.25) end
        local ballPos, rootPos = ball.Position, _root.Position
        local qdx=ballPos.X-rootPos.X; local qdz=ballPos.Z-rootPos.Z
        if abs(qdx)>16 or abs(qdz)>16 then return end
        recordBall(ball)
        local qdy=ballPos.Y-rootPos.Y; local rawDist=sqrt(qdx*qdx+qdy*qdy+qdz*qdz)
        local ahead=_cachedPing+1/60
        local predPos,predVel
        if _cachedPing>=HIGH_PING_MS or rawDist>=7 then predPos,predVel=smartPredict(ball,ahead) else predPos=ballPos; predVel=ball.AssemblyLinearVelocity end
        local farPos=V3(predPos.X+predVel.X*(1/60), predPos.Y+predVel.Y*(1/60)+GRAV_HALF_SQ, predPos.Z+predVel.Z*(1/60))
        local rx,ry,rz = reachSize.X/2, reachSize.Y/2, reachSize.Z/2
        local dx=predPos.X-rootPos.X; local dy=predPos.Y-rootPos.Y; local dz=predPos.Z-rootPos.Z
        local fdx=farPos.X-rootPos.X; local fdy=farPos.Y-rootPos.Y; local fdz=farPos.Z-rootPos.Z
        if rawDist<INSIDE_THRESH then fireLeg(ball) end
        if (abs(dx)<=rx and abs(dy)<=ry and abs(dz)<=rz) or (abs(fdx)<=rx and abs(fdy)<=ry and abs(fdz)<=rz) then fireLeg(ball) end
        reachPart.CFrame = _root.CFrame
    end)
end
local function stopReach2() if reachConn then reachConn:Disconnect(); reachConn=nil end; reachPart.CFrame = CFrame.new(0,-9999,0) end

