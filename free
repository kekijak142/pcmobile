local reachEnabled3, shouldReEnable3, reachDistance3, currentConnection3, storedHip3 = false, false, 16, nil, nil
local function enableReach3()
    if reachEnabled3 then return end; reachEnabled3 = true; shouldReEnable3 = true
    local character = lp.Character or lp.CharacterAdded:Wait()
    local hrp, leg = character:WaitForChild("HumanoidRootPart"), character:WaitForChild("Right Leg")
    if character:FindFirstChild("Right Leg") then character["Right Leg"].Transparency = 1 end
    if character:FindFirstChild("Left Leg") then character["Left Leg"].Transparency = 1 end
    storedHip3 = character:FindFirstChild("Right Hip", true); if storedHip3 then storedHip3.Enabled = false end
    currentConnection3 = RunService.RenderStepped:Connect(function()
        local TPS = workspace:FindFirstChild("TPSSystem") and workspace.TPSSystem:FindFirstChild("TPS")
        if not TPS or not hrp or not leg then return end
        local dir = TPS.Position - hrp.Position
        if dir.Magnitude <= reachDistance3 then leg.CFrame = TPS.CFrame else leg.CFrame = CFrame.new(hrp.Position + dir.Unit * reachDistance3) end
    end)
end
local function disableReach3()
    reachEnabled3 = false; shouldReEnable3 = false
    if currentConnection3 then currentConnection3:Disconnect(); currentConnection3 = nil end
    local char = lp.Character
    if char then
        if char:FindFirstChild("Right Leg") then char["Right Leg"].Transparency = 0 end
        if char:FindFirstChild("Left Leg") then char["Left Leg"].Transparency = 0 end
    end
    if storedHip3 then storedHip3.Enabled = true; storedHip3 = nil end
end
lp.CharacterAdded:Connect(function()
    reachEnabled3 = false; storedHip3 = nil
    if currentConnection3 then currentConnection3:Disconnect(); currentConnection3 = nil end
    if shouldReEnable3 then task.wait(0.25); enableReach3() end
end)

