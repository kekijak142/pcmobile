TabMoss:CreateSection("Moss Hitboxes")

local function createMossBtn(title, bx, by, bz)
    TabMoss:CreateButton(title, function()
        local BOX_Y_OFFSET = 1.5
        local function isBoxTouching(pCF,pSz,tCF,tSz)
            local pMin, pMax = pCF.Position-pSz/2, pCF.Position+pSz/2; local tMin, tMax = tCF.Position-tSz/2, tCF.Position+tSz/2
            return (pMin.X<=tMax.X and pMax.X>=tMin.X) and (pMin.Y<=tMax.Y and pMax.Y>=tMin.Y) and (pMin.Z<=tMax.Z and pMax.Z>=tMin.Z)
        end
        local headerAnim = Instance.new("Animation"); headerAnim.AnimationId = "rbxassetid://301501585"
        local currentTrack = nil
        local function fireKick()
            local TPS = workspace:FindFirstChild("TPSSystem") and workspace.TPSSystem:FindFirstChild("TPS"); if not TPS then return end
            local remote = workspace:FindFirstChild("FE") and workspace.FE:FindFirstChild("System") and workspace.FE.System:FindFirstChild("Header"); if not remote then return end
            remote:FireServer(lp.UserId,TPS,"Rock'n'roll Star","NeverFearTruth","power=95/100")
        end
        local mossWasInside, mossCooldown = false, false
        RunService.Heartbeat:Connect(function()
            local char = lp.Character; if not char then return end
            local head, hrp = char:FindFirstChild("Head"), char:FindFirstChild("HumanoidRootPart"); if not head or not hrp then return end
            local raisedCFrame, boxSize = head.CFrame*CFrame.new(0,BOX_Y_OFFSET,0), Vector3.new(bx,by,bz)
            local targets = {}
            if workspace:FindFirstChild("Balls") then for _,b in workspace.Balls:GetChildren() do if b:IsA("BasePart") then table.insert(targets,b) end end end
            if workspace:FindFirstChild("TPSSystem") then for _,t in workspace.TPSSystem:GetChildren() do if t:IsA("BasePart") or t.Name=="TPS" then table.insert(targets,t) end end end
            local ballInside = false
            for _,t in targets do if t.Position.Y >= hrp.Position.Y+1 and isBoxTouching(raisedCFrame,boxSize,CFrame.new(t.Position+t.Velocity*0.001)*t.CFrame.Rotation,t.Size) then ballInside=true; break end end
            if ballInside and not mossWasInside and not mossCooldown then
                mossCooldown=true; pcall(function() currentTrack=char:FindFirstChildOfClass("Humanoid"):LoadAnimation(headerAnim); currentTrack:Play() end); fireKick(); task.delay(0.3,function() mossCooldown=false end)
            end
            mossWasInside=ballInside
        end)
    end)
end

